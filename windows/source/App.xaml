<Application
    x:Class="FluentScanner.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentScanner">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Shared column widths: header + every row bind here, so a
                 gripper drag resizes the whole table (WinUI has no DataGrid). -->
            <local:ColumnWidths x:Key="Cols" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
