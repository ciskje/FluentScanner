<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentScanner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentScanner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region; caption buttons overlay on the right) -->
        <Grid Grid.Row="0" x:Name="TitleBar" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="FluentScanner" VerticalAlignment="Center"
                       Margin="8,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Standard menu bar -->
        <MenuBar Grid.Row="1">
            <MenuBarItem x:Name="FileMenu">
                <MenuFlyoutItem x:Name="ExportMenuItem" Click="Export_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ExitMenuItem" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem x:Name="ScanMenu">
                <MenuFlyoutItem x:Name="StartMenuItem" Click="Start_Click" />
                <MenuFlyoutItem x:Name="GetIpMenuItem" Click="GetIp_Click" />
            </MenuBarItem>
            <MenuBarItem x:Name="ViewMenu">
                <MenuFlyoutItem x:Name="SettingsMenuItem" Click="Settings_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="ThemeSubItem">
                    <RadioMenuFlyoutItem x:Name="ThemeSystemItem" GroupName="ThemeGroup" Tag="system" Click="ThemeMenu_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeLightItem" GroupName="ThemeGroup" Tag="light" Click="ThemeMenu_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeDarkItem" GroupName="ThemeGroup" Tag="dark" Click="ThemeMenu_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="LangSubItem">
                    <RadioMenuFlyoutItem x:Name="LangSystemItem" GroupName="LangGroup" Tag="system" Click="LangMenu_Click" />
                    <RadioMenuFlyoutItem x:Name="LangEnglishItem" GroupName="LangGroup" Tag="en" Text="English" Click="LangMenu_Click" />
                    <RadioMenuFlyoutItem x:Name="LangItalianItem" GroupName="LangGroup" Tag="it" Text="Italiano" Click="LangMenu_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="MonoMenuItem" Click="MonoMenu_Click" />
                <MenuFlyoutSubItem x:Name="FontSizeSubItem" />
            </MenuBarItem>
            <MenuBarItem x:Name="HelpMenu">
                <MenuFlyoutItem x:Name="HelpMenuItem" Click="Help_Click" />
                <MenuFlyoutItem x:Name="ChangelogMenuItem" Click="Changelog_Click" />
                <MenuFlyoutItem x:Name="AboutMenuItem" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Scan controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="12,6">
            <TextBox x:Name="StartBox" Text="192.168.1.1" MinWidth="140" Width="140"
                     VerticalAlignment="Center" FontFamily="Consolas" KeyDown="Range_KeyDown" />
            <TextBlock Text="–" VerticalAlignment="Center" />
            <TextBox x:Name="EndBox" Text="192.168.1.254" MinWidth="140" Width="140"
                     VerticalAlignment="Center" FontFamily="Consolas" KeyDown="Range_KeyDown" />
            <Button x:Name="GetIpBtn" Click="GetIp_Click" />
            <TextBox x:Name="FilterBox" Width="150" VerticalAlignment="Center"
                     TextChanged="Filter_TextChanged" />
            <Button x:Name="StartBtn" x:Uid="Start" Click="Start_Click" />
            <Button x:Name="StopBtn" x:Uid="Stop" Click="Stop_Click" IsEnabled="False" />
            <Button x:Name="ExportBtn" x:Uid="ExportCsv" Click="Export_Click" IsEnabled="False" />
        </StackPanel>

        <ProgressBar Grid.Row="3" x:Name="Progress" Value="0" Maximum="1" Height="6"
                     Margin="12,0,12,6" />

        <!-- Results: WinUI has no DataGrid — ListView + synced-width header,
             tabular look (zebra rows, column separators, accent header) -->
        <ListView Grid.Row="4" x:Name="Lv" SelectionMode="Extended" IsItemClickEnabled="False">
            <!-- Zero the item containers: default ListViewItem padding/margin
                 would cut the grid lines and paint phantom bands between rows. -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Border BorderThickness="0,0,0,2" Padding="0,0,0,4"
                        BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                    <Grid x:Name="HeaderGrid" ColumnSpacing="12" Padding="12,2,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding W0, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W1, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W2, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W3, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W4, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W5, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W6, Source={StaticResource Cols}}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Name="HdrIp" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                           Tag="0" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                                <local:CursorGripper Width="12" HorizontalAlignment="Right" Margin="0,0,-15,0" Opacity="0"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}" Tag="0"
                                           PointerEntered="Gripper_Enter" PointerExited="Gripper_Exit"
                                           DoubleTapped="Gripper_DoubleTapped"
                                           PointerPressed="Gripper_Press" PointerMoved="Gripper_Move"
                                           PointerReleased="Gripper_Release" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Name="HdrHostname" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                           Tag="1" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                                <local:CursorGripper Width="12" HorizontalAlignment="Right" Margin="0,0,-15,0" Opacity="0"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}" Tag="1"
                                           PointerEntered="Gripper_Enter" PointerExited="Gripper_Exit"
                                           DoubleTapped="Gripper_DoubleTapped"
                                           PointerPressed="Gripper_Press" PointerMoved="Gripper_Move"
                                           PointerReleased="Gripper_Release" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Name="HdrMac" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                           Tag="2" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                                <local:CursorGripper Width="12" HorizontalAlignment="Right" Margin="0,0,-15,0" Opacity="0"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}" Tag="2"
                                           PointerEntered="Gripper_Enter" PointerExited="Gripper_Exit"
                                           DoubleTapped="Gripper_DoubleTapped"
                                           PointerPressed="Gripper_Press" PointerMoved="Gripper_Move"
                                           PointerReleased="Gripper_Release" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="3" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Name="HdrBrand" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                           Tag="3" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                                <local:CursorGripper Width="12" HorizontalAlignment="Right" Margin="0,0,-15,0" Opacity="0"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}" Tag="3"
                                           PointerEntered="Gripper_Enter" PointerExited="Gripper_Exit"
                                           DoubleTapped="Gripper_DoubleTapped"
                                           PointerPressed="Gripper_Press" PointerMoved="Gripper_Move"
                                           PointerReleased="Gripper_Release" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Name="HdrKind" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                           Tag="4" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                                <local:CursorGripper Width="12" HorizontalAlignment="Right" Margin="0,0,-15,0" Opacity="0"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}" Tag="4"
                                           PointerEntered="Gripper_Enter" PointerExited="Gripper_Exit"
                                           DoubleTapped="Gripper_DoubleTapped"
                                           PointerPressed="Gripper_Press" PointerMoved="Gripper_Move"
                                           PointerReleased="Gripper_Release" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="5" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind GridLineBrush, Mode=OneWay}">
                            <Grid>
                                <TextBlock x:Name="HdrServices" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                           Tag="5" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                                <local:CursorGripper Width="12" HorizontalAlignment="Right" Margin="0,0,-15,0" Opacity="0"
                                           Background="{ThemeResource AccentFillColorDefaultBrush}" Tag="5"
                                           PointerEntered="Gripper_Enter" PointerExited="Gripper_Exit"
                                           DoubleTapped="Gripper_DoubleTapped"
                                           PointerPressed="Gripper_Press" PointerMoved="Gripper_Move"
                                           PointerReleased="Gripper_Release" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="6" x:Name="HdrLatency" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}"
                                   Tag="6" Tapped="Header_Tapped" DoubleTapped="Header_DoubleTapped" />
                    </Grid>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HostRow">
                    <Border Background="{x:Bind RowBackground, Mode=OneWay}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                    <Grid ColumnSpacing="12" Padding="12,2,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding W0, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W1, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W2, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W3, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W4, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W5, Source={StaticResource Cols}}" />
                            <ColumnDefinition Width="{Binding W6, Source={StaticResource Cols}}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind DotBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Ip, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                       Foreground="{x:Bind IpForeground, Mode=OneWay}"
                                       FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                            <TextBlock Text="🖥" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                       Visibility="{x:Bind LocalVisibility, Mode=OneWay}" />
                        </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Hostname, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="2" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind Mac, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                       FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                            <TextBlock Text="⇄" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                       Visibility="{x:Bind RandomVisibility, Mode=OneWay}" />
                        </StackPanel>
                        </Border>
                        <Border Grid.Column="3" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Brand, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                   Foreground="{x:Bind BrandBrush, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="4" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Kind, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="5" BorderThickness="0,0,1,0" Padding="0,0,8,0"
                                BorderBrush="{x:Bind RowSeparator, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind PlainServices, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                       Visibility="{x:Bind HasPlainServices, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind Links, Mode=OneWay}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ServiceLink">
                                        <HyperlinkButton Content="{x:Bind Label, Mode=OneWay}"
                                                         Click="ServiceLink_Click" FontSize="12"
                                                         Padding="4,0" MinHeight="0" MinWidth="0"
                                                         VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="6" Text="{x:Bind Latency, Mode=OneWay}" FontSize="{x:Bind RowFontSize, Mode=OneWay}" FontFamily="{x:Bind RowFontFamily, Mode=OneWay}"
                                   FontWeight="{x:Bind RowFontWeight, Mode=OneWay}" />
                    </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer legend (device dots + randomized + self) -->
        <StackPanel Grid.Row="5" Spacing="2" Padding="12,4,12,0">
            <StackPanel x:Name="KindLegendPanel" Orientation="Horizontal" Spacing="10" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="⇄" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RandomLegendTxt" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="🖥" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SelfLegendTxt" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Padding="12,4">
            <ProgressRing x:Name="ScanSpin" Width="14" Height="14" IsActive="False"
                          Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusTxt" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
